#!/usr/bin/env bash
# 提交前跑網站品質檢查；也禁止直接在 main 上提交
branch=$(git symbolic-ref --short HEAD 2>/dev/null)
if [ "$branch" = "main" ] && [ -z "$ALLOW_MAIN_COMMIT" ]; then
  echo "✗ 請不要直接在 main 上提交。先開分支：git switch -c content/<名稱>" >&2
  echo "  （緊急情況可用 ALLOW_MAIN_COMMIT=1 git commit …）" >&2
  exit 1
fi
python3 authoring/check.py
