#!/usr/bin/env bash
# 提交前：禁止直接在 main 提交 → 自動更新 sitemap → 補缺少的分享圖 → 網站品質檢查
branch=$(git symbolic-ref --short HEAD 2>/dev/null)
if [ "$branch" = "main" ] && [ -z "$ALLOW_MAIN_COMMIT" ]; then
  echo "✗ 請不要直接在 main 上提交。先開分支：git switch -c content/<名稱>（或用 authoring/ship.sh）" >&2
  echo "  （緊急情況可用 ALLOW_MAIN_COMMIT=1 git commit …）" >&2
  exit 1
fi
python3 authoring/build-sitemap.py >/dev/null && git add sitemap.xml
# 新文章缺少分享圖時自動以 Chrome 產生並 stage（沒有缺圖時不會啟動 Chrome）
python3 authoring/build-og.py && git add -A images/og assets/img/og.jpg
python3 authoring/check.py
