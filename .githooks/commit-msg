#!/usr/bin/env bash
# 約定式 commit 檢查：type(scope): 描述
msg_file="$1"
first_line=$(grep -v '^#' "$msg_file" | head -n 1)
pattern='^(feat|fix|content|docs|style|refactor|perf|chore|ci|revert)(\([a-z0-9-]+\))?!?: .{1,72}$'
case "$first_line" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac
if ! printf '%s' "$first_line" | grep -Eq "$pattern"; then
  echo "✗ commit 訊息不符合約定式 commit 格式：" >&2
  echo "    $first_line" >&2
  echo "  格式：type(scope): 描述　例：content(article): 新增〈為氣候而走〉心得" >&2
  echo "  type：feat fix content docs style refactor perf chore ci revert" >&2
  exit 1
fi
